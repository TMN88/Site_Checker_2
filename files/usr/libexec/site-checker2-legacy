#!/bin/sh
# Replace only the known TMN88/Site_Checker v1 layout.
set -eu
ACTION=$1
STATE=$2
ROOT=${3:-${SC2_ROOT:-}}
PKG=luci-app-sitecheck
paths() {
cat <<'PATHS'
usr/lib/lua/luci/controller/sitecheck.lua
usr/lib/lua/luci/view/sitecheck/index.htm
usr/libexec/sitecheck-check
usr/libexec/sitecheck-check-zapret
usr/libexec/sitecheck-system-sites
usr/share/luci/menu.d/luci-app-site-checker.json
etc/config/sitecheck
etc/config/sitecheck-opkg
etc/config/sitecheck.opkg-save
etc/config/sitecheck.opkg-old
etc/config/sitecheck.opkg-dist
etc/config/sitecheck.apk-new
etc/config/sitecheck.apk-old
PATHS
}
opkg_cmd() { if [ -n "$ROOT" ]; then opkg --offline-root "$ROOT" "$@"; else opkg "$@"; fi; }
apk_cmd() { if [ -n "$ROOT" ]; then apk --root "$ROOT" "$@"; else apk "$@"; fi; }
package_manager() {
    if command -v apk >/dev/null 2>&1 && apk_cmd info -e "$PKG" >/dev/null 2>&1; then echo apk
    elif command -v opkg >/dev/null 2>&1 && opkg_cmd status "$PKG" 2>/dev/null | grep -q '^Status:.* installed'; then echo opkg
    else echo none; fi
}
check_package_files() {
    case "$1" in
        opkg) opkg_cmd files "$PKG" | awk '/^\// {print substr($0,2)}' > "$STATE/package-files" ;;
        apk) apk_cmd info -L "$PKG" | awk 'NF && !/ contains:$/ {sub(/^\//,"");sub(/\/$/,"");print}' > "$STATE/package-files" ;;
        *) return 0 ;;
    esac
    [ -s "$STATE/package-files" ] || { echo 'Не удалось проверить файлы пакета первой версии.' >&2; return 1; }
    while IFS= read -r rel; do
        if paths | grep -Fxq "$rel"; then continue; fi
        case "$rel" in usr|usr/lib|usr/lib/lua|usr/lib/lua/luci|usr/lib/lua/luci/controller|usr/lib/lua/luci/view|usr/lib/lua/luci/view/sitecheck|usr/libexec|usr/share|usr/share/luci|usr/share/luci/menu.d|etc|etc/config) ;;
            *) echo "Посторонний путь в пакете первой версии: $rel. Замена остановлена." >&2; return 1 ;;
        esac
    done < "$STATE/package-files"
}
plan() {
    mkdir -p "$STATE"
    paths > "$STATE/allowlist"
    while IFS= read -r rel; do
        [ ! -L "$ROOT/$rel" ] || { echo "Ссылка вместо файла первой версии: $rel" >&2; return 1; }
        [ ! -e "$ROOT/$rel" ] || [ -f "$ROOT/$rel" ] || return 1
    done < "$STATE/allowlist"
    manager=$(package_manager)
    printf '%s\n' "$manager" > "$STATE/manager"
    check_package_files "$manager"
    touch "$STATE/ready"
}
retire() {
    [ -f "$STATE/ready" ] || return 1
    while IFS= read -r rel; do
        [ ! -L "$ROOT/$rel" ] || return 1
        [ ! -e "$ROOT/$rel" ] || [ -f "$ROOT/$rel" ] || return 1
    done < "$STATE/allowlist"
    manager=$(cat "$STATE/manager")
    case "$manager" in
        opkg)
            opkg_cmd --noaction remove "$PKG" > "$STATE/package-plan" 2>&1 || { cat "$STATE/package-plan"; return 1; }
            # Do not let the package manager preserve a modified v1 configuration.
            rm -f "$ROOT/etc/config/sitecheck"
            opkg_cmd remove "$PKG" || return 1
            ;;
        apk)
            apk_cmd --simulate --no-scripts --no-commit-hooks del "$PKG" > "$STATE/package-plan" 2>&1 || { cat "$STATE/package-plan"; return 1; }
            awk '
              /Purging/ {line=$0;sub(/^.*Purging[ \t]+/,"",line);sub(/[ \t].*$/,"",line);if(line!="luci-app-sitecheck")exit 1;seen=1}
              /Installing|Upgrading|Downgrading|Reinstalling/ {exit 1}
              END {if(!seen)exit 1}
            ' "$STATE/package-plan" || { echo 'План apk затрагивает дополнительные пакеты или не распознан. Первая версия не удалена.' >&2; return 1; }
            rm -f "$ROOT/etc/config/sitecheck"
            apk_cmd --no-scripts --no-commit-hooks del "$PKG" || return 1
            ;;
    esac
    while IFS= read -r rel; do
        paths | grep -Fxq "$rel" || return 1
        rm -f "$ROOT/$rel"
        [ ! -e "$ROOT/$rel" ] || return 1
    done < "$STATE/allowlist"
    rmdir "$ROOT/usr/lib/lua/luci/view/sitecheck" 2>/dev/null || true
    echo 'Первая версия Site Checker удалена вместе с конфигурацией. Резервная копия не создавалась.'
}
case "$ACTION" in plan) plan ;; retire) retire ;; *) exit 2 ;; esac
