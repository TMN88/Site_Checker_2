#!/bin/sh
# Validate a single ASCII domain, IPv4 or IPv6 address.
target=$1
case "$target" in ''|*[!A-Za-z0-9.:-]*) exit 1 ;; esac
printf '%s\n' "$target" | awk '
function ipv4(s, a,n,i) {
 n=split(s,a,"."); if(n!=4)return 0;
 for(i=1;i<=4;i++) if(a[i]!~/^[0-9]+$/ || length(a[i])>3 || a[i]+0>255)return 0;
 return 1;
}
function ipv6(s, a,n,i,c,t) {
 if(s~/[.]/) {
  n=split(s,a,":"); if(!ipv4(a[n]))return 0;
  sub(/[0-9.]+$/,"0:0",s);
 }
 if(s!~/^[0-9a-fA-F:]+$/ || s~/:::/)return 0;
 t=s;c=gsub(/::/,"X",t); if(c>1)return 0;
 n=split(s,a,":");
 if(c==0 && n!=8)return 0;
 c=0;for(i=1;i<=n;i++)if(a[i]!=""){if(length(a[i])>4)return 0;c++;}
 if(s~/::/)return c<8;
 return c==8;
}
{
 if(length($0)>253)exit 1;
 if(index($0,":")){if(!ipv6($0))exit 1;}
 else if($0~/^[0-9.]+$/){if(!ipv4($0))exit 1;}
 else {
  n=split($0,a,".");for(i=1;i<=n;i++)if(a[i]=="" || length(a[i])>63 || a[i]~/^-|-$|[^A-Za-z0-9-]/)exit 1;
 }
 print tolower($0);
}'
